DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ASSISTANT_ENABLED=true
AI_PROVIDER_MODE=demo
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

DATABASE_URL=postgres://realityng:realityng@postgres:5432/realityng
POSTGRES_DB=realityng
POSTGRES_USER=realityng
POSTGRES_PASSWORD=realityng

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=realityng-local
USE_S3_MEDIA_STORAGE=false
PROPERTY_IMAGE_MAX_COUNT=30
PROPERTY_IMAGE_MAX_SIZE_MB=10
PROPERTY_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
PROPERTY_IMAGE_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
VERIFICATION_DOCUMENT_BUCKET_NAME=realityng-verification-private
VERIFICATION_DOCUMENT_MAX_SIZE_MB=10
VERIFICATION_DOCUMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
VERIFICATION_DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
VERIFICATION_SIGNED_URL_EXPIRY=300
WALKTHROUGH_MAX_FILE_SIZE_MB=100
WALKTHROUGH_MAX_VIDEOS_PER_PROPERTY=3
WALKTHROUGH_ALLOWED_MIME_TYPES=video/mp4,video/webm
WALKTHROUGH_ALLOWED_EXTENSIONS=.mp4,.webm
WALKTHROUGH_STORAGE_BUCKET=realityng-walkthroughs
WALKTHROUGH_UPLOAD_URL_EXPIRY_SECONDS=900
WALKTHROUGH_PUBLIC_BASE_URL=
WALKTHROUGH_REQUIRE_MODERATION=true
INSPECTION_EVIDENCE_BUCKET=realityng-inspection-evidence
INSPECTION_REPORT_BUCKET=realityng-inspection-reports
INSPECTION_SIGNED_URL_EXPIRY_SECONDS=300
INSPECTION_MAX_EVIDENCE_FILE_SIZE_MB=25
INSPECTION_MAX_REPORT_FILE_SIZE_MB=25
INSPECTION_EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4,video/webm,audio/mpeg,audio/wav
INSPECTION_EVIDENCE_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.mp4,.webm,.mp3,.wav
INSPECTION_REPORT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
INSPECTION_REPORT_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
CONSTRUCTION_EVIDENCE_BUCKET=realityng-construction-evidence
CONSTRUCTION_SIGNED_URL_EXPIRY_SECONDS=300
CONSTRUCTION_MAX_IMAGE_SIZE_MB=25
CONSTRUCTION_MAX_VIDEO_SIZE_MB=100
CONSTRUCTION_MAX_DOCUMENT_SIZE_MB=25
CONSTRUCTION_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
CONSTRUCTION_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
CONSTRUCTION_ALLOWED_DOCUMENT_TYPES=application/pdf
CONSTRUCTION_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp4,.webm,.pdf

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
